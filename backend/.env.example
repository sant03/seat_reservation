# Puerto del servidor
PORT=3000

# Tipo de almacenamiento: filesystem (desarrollo) o github (produccion)
STORAGE_TYPE=filesystem

# --- Solo si STORAGE_TYPE=filesystem ---
FS_FILE_PATH=data/ListadoBus.xlsx

# --- Solo si STORAGE_TYPE=github ---
# Token de GitHub con permiso de Contenidos (solo la carpeta del .xlsx)
GITHUB_TOKEN=
GITHUB_OWNER=tu-usuario
GITHUB_REPO=nombre-del-repo
GITHUB_FILE_PATH=datos/ListadoBus.xlsx
GITHUB_BRANCH=main
GITHUB_AUTHOR_NAME=Bus App
GITHUB_AUTHOR_EMAIL=busapp@example.com